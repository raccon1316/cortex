# AgencyOS SaaS — environment template.
# Copy to .env.local and fill in from your Supabase project dashboard
# (Project Settings → Data API). Never commit real keys.

# Public — safe to expose to the browser (anon access is gated by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# New-style key name (Supabase 2025+). Preferred.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Legacy alias for the same key — the app accepts either. Only needed if
# your project dashboard still labels it "anon key".
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — bypasses RLS. Keep on the server (Vercel env vars, NOT
# NEXT_PUBLIC_). Only used by lib/supabase/admin.ts (webhooks, bootstrap).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Monetization (Part F) — all optional; the app runs without them. ---

# Stripe self-serve upgrades (app/api/billing/*). Set all three to activate
# the /pricing upgrade button; STRIPE_WEBHOOK_SECRET comes from
# stripe listen / the Stripe dashboard webhook endpoint settings.
# STRIPE_SECRET_KEY=sk_live_or_test_key
# STRIPE_PRICE_ID=price_recurring_pro_price_id
# STRIPE_WEBHOOK_SECRET=whsec_...

# Invite emails (app/actions.ts sendInviteEmail). Without a key, invites fall
# back to copy-link only. EMAIL_FROM must be a verified Resend sender.
# RESEND_API_KEY=re_...
# EMAIL_FROM="AgencyOS <invites@yourdomain.com>"

# Weekly digest cron (app/api/digest/weekly + CRON.md). Shared secret for the
# Monday sender; without RESEND_API_KEY the digest logs to console instead.
# DIGEST_CRON_SECRET=long-random-string

# Fallback origin for building invite links when the request Host header
# isn't trustworthy (e.g. behind some proxies). Usually unnecessary.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Verification harness (scripts/verify-rls.mjs): defaults to PGlite (real
# Postgres 17 compiled to WASM, in-process — no Docker, no credentials; the
# backend in use is printed at the top of every run) and applies
# supabase/migrations/ to a fresh throwaway DB. Run: npm run verify:rls
# Optional: point PG_TEST_URL at a REAL, EMPTY Postgres (e.g. a throwaway
# Docker container) to run the identical 16-check suite against the real
# engine. The URL is printed masked (password removed). NEVER point it at a
# live/shared database — the harness creates roles and applies migrations
# from scratch, so it requires a disposable database.
# Example: postgres://postgres:postgres@localhost:5433/postgres
# PG_TEST_URL=

# Browser E2E only (Part F): password of the demo login, used by e2e/*.spec.ts
# via DEMO_TEST_PASSWORD. Test-only value, lives in .env.local (never committed).
# DEMO_TEST_PASSWORD=change-me-after-seed
